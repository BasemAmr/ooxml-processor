{
  "name": "@ooxml/demo",
  "version": "0.0.0",
  "description": "Vite app: open a .docx, edit it, save it.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc --build",
    "dev": "vite --host 127.0.0.1",
    "build:web": "vite build",
    "test:run": "vitest run",
    "clean": "tsc --build --clean"
  },
  "dependencies": {
    "@ooxml/conformance": "workspace:*",
    "@ooxml/dml": "workspace:*",
    "@ooxml/editor": "workspace:*",
    "@ooxml/layout": "workspace:*",
    "@ooxml/opc": "workspace:*",
    "@ooxml/paint": "workspace:*",
    "@ooxml/schema": "workspace:*",
    "@ooxml/text": "workspace:*",
    "@ooxml/wml": "workspace:*"
  }
}
