# pnpm-specific settings do NOT belong here — pnpm 10+ reads them from
# pnpm-workspace.yaml and silently ignores them in .npmrc. This file is only
# for settings the underlying npm/node tooling reads.

# Playwright is a Phase 11 dependency (~1GB of browsers). Do not let any
# transitive postinstall pull browsers down before we actually need them.
# See docs/adr/0001-repo-location-and-disk-budget.md.
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
